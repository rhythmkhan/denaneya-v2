# DenaNeya v2.0 Environment Configuration

# Application
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# Database Client: 'sqlite' or 'mysql'
DB_CLIENT=sqlite
# SQLite Path (relative or ':memory:')
DB_SQLITE_PATH=./packages/database/data/denaneya.sqlite

# MySQL (Production Hostinger)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456_denaneya
DB_PASSWORD=SecurePasswordHere123!
DB_DATABASE=u123456_denaneya_db
DB_CONNECTION_LIMIT=10

# Security & Secrets
JWT_SECRET=super_secure_jwt_secret_minimum_32_characters_long_12345
WEBHOOK_DEFAULT_SECRET=whsec_development_secret_minimum_32_chars_12345
REPLAY_TOLERANCE_SECONDS=300

# Frontend
DASHBOARD_URL=http://localhost:3000
WEB_URL=http://localhost:3001
